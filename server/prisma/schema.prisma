// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum ChannelType {
  WHATSAPP
  EMAIL
  INSTAGRAM
  MESSENGER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("STARTER") // STARTER, PRO, ENTERPRISE
  settings  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription        Subscription?
  users               User[]
  contacts            Contact[]
  waInstances         WhatsAppInstance[]
  pipelines           Pipeline[]
  products            Product[]
  orders              Order[]
  transactions        Transaction[]
  workflows           Workflow[]
  conversations       Conversation[]
  auditLogs           AuditLog[]
  campaigns           Campaign[]
}

model Subscription {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingCustomerId String?  // ID do cliente no Asaas/Stripe
  billingSubId      String?  // ID da assinatura no gateway
  status            String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, INCOMPLETE
  planId            String   // Identificador do plano
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(AGENT)
  isActive      Boolean  @default(true)
  isOnline      Boolean  @default(false)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages      Message[]
}

model Contact {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  phone       String?
  email       String?
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  deals         Deal[]
  orders        Order[]
  campaignTargets CampaignTarget[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
}

model WhatsAppInstance {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  phoneNumber       String
  waBusinessId      String   @default("")
  accessToken       String   @default("")
  connectionType    String   @default("OFFICIAL") // "OFFICIAL" ou "UNOFFICIAL"
  unofficialUrl     String?
  unofficialToken   String?
  qrCode            String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, phoneNumber])
}

model Conversation {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])
  channel       ChannelType @default(WHATSAPP)
  status        String      @default("OPEN")
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages      Message[]
}

model Message {
  id              String           @id @default(uuid())
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id])
  senderId        String?
  sender          User?            @relation(fields: [senderId], references: [id])
  direction       MessageDirection
  content         String
  type            String           @default("text") // text, image, audio, file
  metadata        Json?
  createdAt       DateTime         @default(now())
}

model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    Stage[]
}

model Stage {
  id          String   @id @default(uuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  name        String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
}

model Deal {
  id          String     @id @default(uuid())
  contactId   String
  contact     Contact    @relation(fields: [contactId], references: [id])
  stageId     String
  stage       Stage      @relation(fields: [stageId], references: [id])
  title       String
  value       Decimal?   @db.Decimal(10, 2)
  status      DealStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  transactions Transaction[]
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  total       Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  dealId      String?
  deal        Deal?             @relation(fields: [dealId], references: [id])
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  status      TransactionStatus @default(PENDING)
  description String?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  trigger     String   // e.g., "message.received", "deal.created"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actions     WorkflowAction[]
}

model WorkflowAction {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  type        String   // e.g., "send_message", "create_task", "update_deal"
  config      Json
  order       Int
}

model AuditLog {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String?
  action        String    // ex: "lead.move", "user.login", "whatsapp.disconnect"
  description   String    // Detalhamento por extenso
  ipAddress     String
  device        String    // User-Agent completo
  location      String?   // Localização aproximada por IP
  meta          Json?     // Estado anterior vs. Novo estado
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Campaign {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  name        String
  status      String           @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  message     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  targets     CampaignTarget[]
}

model CampaignTarget {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id])
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  error       String?
  sentAt      DateTime?
}
