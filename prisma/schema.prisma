generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. NÚCLEO DO CRM (Workspace e Usuários)
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pixKey String? // Chave Pix da empresa, informada manualmente para cobrança das Ordens de Serviço

  users            User[]
  companies        Company[]
  contacts         Contact[]
  pipelines        Pipeline[]
  deals            Deal[]
  tasks            Task[]
  integrations     Integration[]
  tags             Tag[]
  aiAgents         AiAgent[]
  stageAutomations StageAutomation[]
  feedbacks        Feedback[]
  serviceOrders    ServiceOrder[]
  employees        Employee[]
  automationFlows  AutomationFlow[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String   @unique
  role      String   @default("AGENT") // ADMIN, AGENT
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals                 Deal[] // Deals assigned to this user
  tasks                 Task[] // Tasks assigned to this user
  messages              Message[] // Messages sent by this user
  feedbacks             Feedback[]
  activities            Activity[] // ações que este usuário registrou
  serviceOrderHistories ServiceOrderHistory[]
}

// ==========================================
// 2. PESSOAS E EMPRESAS
// ==========================================

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  website   String?
  cnpj      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts      Contact[] // A company has many contacts
  deals         Deal[] // Deals directly tied to the company
  serviceOrders ServiceOrder[]
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String?
  name      String
  phone     String?
  email     String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals         Deal[]
  tags          TagsOnContacts[]
  serviceOrders ServiceOrder[]
}

// ==========================================
// 3. MOTOR DE VENDAS (Funil e Leads)
// ==========================================

model Pipeline {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // Ex: "Funil de Vendas", "Pós-Venda"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  deals  Deal[]
}

model Stage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String // Ex: "Comentário ou DM", "Qualificado"
  order      Int // To sort columns (0, 1, 2...)
  color      String? // Ex: "bg-blue-500"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline   Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]
  automation StageAutomation?
}

model Deal {
  id         String   @id @default(uuid())
  tenantId   String
  pipelineId String
  stageId    String
  contactId  String?
  companyId  String?
  assignedTo String? // User ID
  title      String
  value      Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage    Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company  Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignee User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  tasks         Task[]
  tags          TagsOnDeals[]
  conversations Conversation[]
  activities    Activity[] // System logs (moved stage, changed value)
  serviceOrders ServiceOrder[]
}

// ==========================================
// 4. CALENDÁRIO E TAREFAS
// ==========================================

model Task {
  id          String   @id @default(uuid())
  tenantId    String
  dealId      String?
  assignedTo  String?
  title       String
  description String?
  type        String   @default("MEETING") // CALL, MEETING, TASK, DEADLINE
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal?  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
}

// ==========================================
// 5. COMUNICAÇÕES (Inbox e Chatbot)
// ==========================================

model Channel {
  id        String   @id @default(uuid())
  tenantId  String
  name      String // "WhatsApp da Loja", "Instagram Principal"
  provider  String // "whatsapp", "instagram"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(uuid())
  dealId    String
  channelId String
  status    String   @default("OPEN") // OPEN, CLOSED, WAITING
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal             Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  channel          Channel           @relation(fields: [channelId], references: [id], onDelete: Restrict)
  messages         Message[]
  sentScriptBlocks SentScriptBlock[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  authorId       String? // If sent by a User
  authorType     String // "CONTACT", "USER", "AI", "SYSTEM"
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userAuthor   User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// ==========================================
// 6. ORGANIZAÇÃO (Tags e Logs)
// ==========================================

model Tag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals    TagsOnDeals[]
  contacts TagsOnContacts[]

  @@unique([tenantId, name])
}

model TagsOnDeals {
  dealId String
  tagId  String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

model TagsOnContacts {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// Old system logs, kept for audit trails
model Activity {
  id        String   @id @default(uuid())
  tenantId  String
  dealId    String
  type      String // STAGE_CHANGED, NOTE_ADDED
  content   String
  author    String // "System", "Agent"
  userId    String? // quem de fato fez a ação, quando aplicável
  createdAt DateTime @default(now())

  deal Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Integration {
  id         String   @id @default(uuid())
  tenantId   String
  provider   String
  apiKey     String?
  webhookUrl String?
  config     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiAgent AiAgent?
}

// ==========================================
// 7. AGENTE DE IA (Salesbot)
// ==========================================

model AiAgent {
  id                 String  @id @default(uuid())
  tenantId           String
  integrationId      String? @unique // a qual número/integração este agente pertence (nulo = ainda não vinculado)
  name               String  @default("Assistente de Vendas")
  isActive           Boolean @default(false)
  systemPrompt       String? // O "Persona"
  personalityTags    String? // JSON stringified array (ex: ["Confiante","Direto"]) — substitui o antigo toneOfVoice
  responseSize       String  @default("Médias")
  responseLanguage   String  @default("Correspondente")
  pauseSeconds       Int     @default(3)
  directives         String? // JSON stringified array de regras gerais
  typicalExpressions String? // JSON stringified array de frases/bordões do atendimento
  negativePrompt     String? // O que o agente NUNCA deve fazer ou dizer

  // MANUAL: agente nunca cria Ordem de Serviço sozinho.
  // SEMI_AUTO: agente monta um rascunho (status RASCUNHO) que um humano confirma.
  // AUTO: agente pode abrir a OS diretamente — reservado pra depois que o
  // fluxo semiautomático tiver rodado bem; a criação automática ainda não
  // está implementada nesta fase (ver docs/ROADMAP.md).
  serviceOrderMode String @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration      Integration?           @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  scriptSteps      AgentScriptStep[]
  objections       AgentObjection[]
  knowledgeSources AgentKnowledgeSource[]
}

// "Fontes": texto que o dono do negócio cola/escreve (tabela de preços,
// medidas padrão, especificações) pra IA usar como referência ao responder
// e montar orçamentos. Injetado direto no system prompt (ver
// src/lib/agentPrompt.ts) — sem embeddings/busca vetorial nesta fase; para
// o volume de texto de um catálogo de preços de uma PME isso cabe tranquilo
// no contexto do modelo. Se algum tenant precisar de uma base muito maior,
// aí sim vale evoluir pra RAG de verdade.
model AgentKnowledgeSource {
  id        String   @id @default(uuid())
  aiAgentId String
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
}

// Etapas nomeadas e ordenáveis do roteiro de conversa — `type` separa o
// funil de atendimento (qualificação) do funil de fechamento (venda).
model AgentScriptStep {
  id        String   @id @default(uuid())
  aiAgentId String
  type      String // "ATENDIMENTO" | "FECHAMENTO"
  order     Int
  title     String
  content   String? // instrução/roteiro que a IA deve seguir nesta etapa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiAgent AiAgent                @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  blocks  AgentScriptStepBlock[]
}

// Conteúdo concreto e ordenável de uma etapa — texto literal ou mídia —
// enviado via tool-calling (enviarBlocoDaEtapa, ver src/lib/aiReply.ts)
// no momento em que a IA decide disparar a etapa. Substitui o antigo par
// mediaType/mediaUrl (um único anexo por etapa) por uma lista, pra dar
// pra empilhar várias mensagens (texto, depois imagem, depois texto...)
// numa etapa só.
model AgentScriptStepBlock {
  id        String   @id @default(uuid())
  stepId    String
  order     Int
  type      String // "TEXT" | "AUDIO" | "IMAGE" | "VIDEO"
  content   String? // texto literal — obrigatório se type = TEXT
  mediaUrl  String? // URL pública (bucket agent-media) — obrigatório se AUDIO/IMAGE/VIDEO
  createdAt DateTime @default(now())

  step        AgentScriptStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentRecords SentScriptBlock[]
}

// Marca quais blocos já foram enviados em qual conversa — a IA usa isso
// pra saber o que já mandou e o que ainda falta avançar no funil, em vez
// de só inferir pelo histórico de mensagens (que fica pouco confiável
// quando o prompt já tem os dois scripts inteiros + objeções).
model SentScriptBlock {
  id             String   @id @default(uuid())
  conversationId String
  blockId        String
  sentAt         DateTime @default(now())

  conversation Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  block        AgentScriptStepBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([conversationId, blockId])
}

// Biblioteca de objeções conhecidas ("Tá caro", "Vou pensar"...) e como o
// agente deve responder a cada uma.
model AgentObjection {
  id        String   @id @default(uuid())
  aiAgentId String
  order     Int
  title     String
  response  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiAgent AiAgent @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. CONFIGURAÇÕES GLOBAIS (Super Admin)
// ==========================================

model SystemConfig {
  key       String   @id // Ex: "OPENAI_MASTER_KEY"
  value     String
  updatedAt DateTime @updatedAt
}

// ==========================================
// 9. AUTOMAÇÕES (versão mínima — motor completo é Fase 2)
// ==========================================

// Liga o Agente de IA e/ou dispara o webhook do n8n quando QUALQUER deal
// entra nesta etapa. Não é um builder de regras (isso é Fase 2): só liga o
// que já existe (AiAgent do tenant, Integration provider="n8n").
// `activateAgent` ativa o AiAgent do tenant inteiro — ainda não há um toggle
// de IA por conversa/deal no schema.
model StageAutomation {
  id             String   @id @default(uuid())
  tenantId       String
  stageId        String   @unique
  activateAgent  Boolean  @default(false)
  fireN8nWebhook Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stage  Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

// Motor de fluxo visual (canvas estilo ManyChat) — Fase B. Sem nó de
// espera/delay nesta fase, então um fluxo roda do TRIGGER até o fim numa
// passada só, dentro da mesma invocação do webhook — não precisa de
// estado de execução persistente por contato.
model AutomationFlow {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  triggerType   String // "KEYWORD" | "WELCOME"
  triggerConfig String? // JSON: {"keywords": ["oi","ola"]} para KEYWORD
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nodes  AutomationFlowNode[]
  edges  AutomationFlowEdge[]
}

model AutomationFlowNode {
  id        String   @id @default(uuid())
  flowId    String
  type      String // "TRIGGER" | "SEND_MESSAGE" | "SEND_MEDIA" | "CONDITION" | "ADD_TAG" | "AI_HANDOFF"
  positionX Float
  positionY Float
  data      String // JSON, formato depende do type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
}

model AutomationFlowEdge {
  id           String   @id @default(uuid())
  flowId       String
  sourceNodeId String
  targetNodeId String
  sourceHandle String? // "true" | "false" — só em saída de nó CONDITION
  createdAt    DateTime @default(now())

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
}

// ==========================================
// 10. ORDENS DE SERVIÇO
// ==========================================

// Pessoa que executa o serviço em campo. Modelo enxuto e sem login próprio
// de propósito — não é um usuário do Supabase Auth, só um cadastro pra
// atribuir responsabilidade por uma Ordem de Serviço. Se no futuro o técnico
// precisar logar (ex.: pelo app mobile pra ver a própria agenda), aí sim
// vira um User com role TECHNICIAN — decisão consciente de não construir
// login/convite agora pra não inflar o escopo antes de precisar.
model Employee {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  specialty String? // Ex: "Instalador", "Cortador de vidro"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
}

// `number` é sequencial por tenant (não globalmente único) — calculado em
// transação no momento da criação, ver src/actions/serviceOrders.ts.
model ServiceOrder {
  id            String    @id @default(uuid())
  tenantId      String
  number        Int
  dealId        String?
  contactId     String?
  companyId     String?
  employeeId    String?
  title         String
  description   String?
  status        String    @default("ABERTA") // RASCUNHO, ABERTA, EM_ANDAMENTO, CONCLUIDA, CANCELADA
  value         Float     @default(0)
  paymentStatus String    @default("PENDENTE") // PENDENTE, PAGO, PARCIAL
  paymentMethod String? // PIX, BOLETO, CARTAO, DINHEIRO
  source        String    @default("MANUAL") // MANUAL, IA — quem criou a OS
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal?                 @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact  Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company  Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employee Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  history  ServiceOrderHistory[]

  @@unique([tenantId, number])
}

// Histórico de mudanças sensíveis de uma Ordem de Serviço (status ou
// funcionário responsável) — cada linha é uma mudança, com quem fez.
// Tabela própria (não reaproveita Activity) porque OS não tem timeline
// tipo chat hoje; é mais parecido com log de auditoria puro.
model ServiceOrderHistory {
  id             String   @id @default(uuid())
  tenantId       String
  serviceOrderId String
  userId         String
  field          String // "STATUS" | "EMPLOYEE" | "PAYMENT"
  fromValue      String?
  toValue        String?
  reason         String? // obrigatório só quando reabre um status Concluída
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ==========================================
// 11. FEEDBACK DE PRODUTO
// ==========================================

model Feedback {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  type      String   @default("SUGGESTION") // SUGGESTION, BUG, OTHER
  message   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}
